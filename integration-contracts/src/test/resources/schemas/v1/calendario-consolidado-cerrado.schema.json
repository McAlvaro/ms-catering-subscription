{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ms-catering-subscription.example/schemas/outbox/v1/calendario-consolidado-cerrado.schema.json",
    "title": "bc3.CalendarioConsolidadoCerrado v1",
    "allOf": [
        {
            "$ref": "integration-event-envelope.schema.json"
        },
        {
            "type": "object",
            "properties": {
                "eventName": {
                    "const": "bc3.CalendarioConsolidadoCerrado"
                },
                "data": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "idCalendario",
                        "fechaEntrega",
                        "fechaCierre",
                        "totalEntregas",
                        "entregas"
                    ],
                    "properties": {
                        "idCalendario": {
                            "type": "string",
                            "format": "uuid"
                        },
                        "fechaEntrega": {
                            "type": "string",
                            "format": "date"
                        },
                        "fechaCierre": {
                            "type": "string",
                            "format": "date-time"
                        },
                        "totalEntregas": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "entregas": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                    "idCalendarioDia",
                                    "idSuscripcion",
                                    "idPaciente",
                                    "nombrePaciente",
                                    "idPlan",
                                    "numDiaPlan",
                                    "direccion",
                                    "recetas"
                                ],
                                "properties": {
                                    "idCalendarioDia": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "idSuscripcion": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "idPaciente": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "nombrePaciente": {
                                        "type": "string",
                                        "minLength": 1
                                    },
                                    "idPlan": {
                                        "type": "string",
                                        "format": "uuid"
                                    },
                                    "numDiaPlan": {
                                        "type": "integer",
                                        "minimum": 1
                                    },
                                    "direccion": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                            "idDireccion",
                                            "alias",
                                            "direccion",
                                            "referencia",
                                            "ciudad",
                                            "latitud",
                                            "longitud"
                                        ],
                                        "properties": {
                                            "idDireccion": {
                                                "type": "string",
                                                "format": "uuid"
                                            },
                                            "alias": {
                                                "type": "string",
                                                "minLength": 1
                                            },
                                            "direccion": {
                                                "type": "string",
                                                "minLength": 1
                                            },
                                            "referencia": {
                                                "type": "string",
                                                "minLength": 1
                                            },
                                            "ciudad": {
                                                "type": "string",
                                                "minLength": 1
                                            },
                                            "latitud": {
                                                "type": "number",
                                                "minimum": -90,
                                                "maximum": 90
                                            },
                                            "longitud": {
                                                "type": "number",
                                                "minimum": -180,
                                                "maximum": 180
                                            }
                                        }
                                    },
                                    "recetas": {
                                        "type": "array",
                                        "minItems": 1,
                                        "items": {
                                            "type": "object",
                                            "additionalProperties": false,
                                            "required": [
                                                "idReceta",
                                                "nombre",
                                                "hora",
                                                "porcionGramos"
                                            ],
                                            "properties": {
                                                "idReceta": {
                                                    "type": "string",
                                                    "format": "uuid"
                                                },
                                                "nombre": {
                                                    "type": "string",
                                                    "minLength": 1
                                                },
                                                "hora": {
                                                    "type": "string",
                                                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                                                },
                                                "porcionGramos": {
                                                    "type": "number",
                                                    "exclusiveMinimum": 0
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    ]
}
