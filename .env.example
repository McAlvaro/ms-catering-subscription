MYSQL_ROOT_PASSWORD=root_secret
MYSQL_DATABASE=ms_catering_subscription
MYSQL_USER=admin_db
MYSQL_PASSWORD=123456

MYSQL_HOST_PORT=3325

APP_HOST_PORT=8080
APP_IMAGE=alv641/ms-catering-subscription:1.1.0

# Service Discovery (Eureka Server)
EUREKA_SERVER_URL=http://localhost:8761/eureka/
EUREKA_PREFER_IP_ADDRESS=true

# Apache Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PATIENT_TOPIC=bc1.pacientes.eventos
KAFKA_PLAN_TOPIC=bc2.nutricion.eventos
KAFKA_DELIVERY_TOPIC=bc5.logistica.eventos

